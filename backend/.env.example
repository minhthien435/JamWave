# Copy file này thành `.env` và điền giá trị thật.
# LƯU Ý: Không bao giờ commit file .env lên git.

# Connection string PostgreSQL (local hoặc Supabase/Neon)
# Ví dụ local: postgresql://postgres:password@localhost:5432/spotify_clone
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dbname"

# Cổng chạy backend Express (mặc định 5000)
PORT=5000

# Secret dùng để ký JWT - thay bằng chuỗi ngẫu nhiên dài
JWT_SECRET=change-me-to-a-long-random-string
