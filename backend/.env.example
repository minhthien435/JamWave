# Copy file này thành `.env` và điền giá trị thật.
# LƯU Ý: Không bao giờ commit file .env lên git.

# Connection string PostgreSQL (local hoặc Supabase/Neon)
# Ví dụ local: postgresql://postgres:password@localhost:5432/spotify_clone
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dbname"

# Cổng chạy backend Express (mặc định 5000)
PORT=5000

# Secret dùng để ký JWT - thay bằng chuỗi ngẫu nhiên dài
JWT_SECRET=change-me-to-a-long-random-string

# CORS: danh sách origin được phép gọi API, phân cách bằng dấu phẩy
# Để trống = cho phép mọi origin (chỉ nên dùng khi dev)
# Ví dụ production: https://jamwave.onrender.com,http://localhost:5173
CLIENT_ORIGIN=

# Email này sẽ tự động được cấp quyền ADMIN (quản trị viên) khi đăng ký/đăng nhập
ADMIN_EMAIL=your-admin-email@example.com

# ---- Lyrics: Musixmatch (TÙY CHỌN, fallback sau LRCLIB) ----
# Lấy key miễn phí tại https://developer.musixmatch.com (1.000 request/ngày, plain lyrics)
# Không có key = hệ thống chỉ dùng LRCLIB (miễn phí, có synced lyrics)
MUSIXMATCH_API_KEY=your-musixmatch-api-key

# ---- Nguồn nhạc: Jamendo (MIỄN PHÍ, full-length, CC license) ----
# Lấy client_id tại https://devportal.jamendo.com (Create application)
JAMENDO_CLIENT_ID=your-jamendo-client-id

# ---- AI Trợ lý nhạc (TÙY CHỌN) ----
# Nếu không cấu hình, chat-box vẫn hoạt động với dữ liệu thư viện (gợi ý nhạc,
# đếm bài hát, năm phát hành...). Thêm key để AI trả lời tự do tốt hơn
# (ví dụ: tra cứu nhà sáng tác). Tương thích OpenAI chat/completions format.

# Cách 1 (MIỄN PHÍ): Google Gemini - lấy key tại https://aistudio.google.com (không cần thẻ)
# AI_API_KEY=your-gemini-api-key
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-flash-latest

# Cách 2: DeepSeek - key tại https://platform.deepseek.com (nạp tối thiểu ¥10)
# AI_API_KEY=your-deepseek-api-key
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat

# ---- RAG / Semantic search: Gemini Embedding (dùng chung AI_API_KEY Gemini) ----
# Tạo vector 3072 chiều cho mỗi bài để chat tìm nhạc theo ý nghĩa/mood/vibe.
# Không cần thêm key riêng: tái dùng AI_API_KEY + AI_BASE_URL ở trên. Chạy: npm run embed
GEMINI_EMBED_MODEL=gemini-embedding-001

# ---- MusicBrainz (metadata nền, CC0, MIỄN PHÍ, KHÔNG cần key) ----
# Dùng để làm giàu metadata: nghệ sĩ (mbid, aliases, genres) và bài hát (mbid, isrc).
# Chạy: npm run mb-enrich  (resumable, tôn trọng rate limit 1 req/s của MusicBrainz)
# User-Agent nên đặt tên app + liên hệ (MusicBrainz yêu cầu User-Agent ý nghĩa)
MB_USER_AGENT=JamWave/1.0 (https://your-app.example.com)
# Giới hạn để test nhanh (0 = chạy hết). Đặt qua env khi chạy: MB_ARTIST_LIMIT=10 MB_SONG_LIMIT=20 npm run mb-enrich
# MB_ARTIST_LIMIT=0
# MB_SONG_LIMIT=0
